#!/usr/bin/env ruby

require_relative "../config/boot"
require_relative "../app/services/s3_handler"
require 'aws-sdk-s3'
require 'logger'

$stdout.sync = true
logger = Logger.new($stdout)
s3_bucket_name = ENV.fetch('S3_BUCKET_NAME', 'pdf-accessibility-api')

begin
  s3_client = Aws::S3::Client.new(
    credentials: Aws::Credentials.new(
        ENV.fetch('AWS_ACCESS_KEY_ID', 'pdf_accessibility_api'),
        ENV.fetch('AWS_SECRET_ACCESS_KEY', 'pdf_accessibility_api')
      ),
    endpoint: ENV.fetch('S3_ENDPOINT', 'http://seaweedfs:8333'),
    region: ENV.fetch('AWS_REGION', 'us-east-1'),
    force_path_style: true
  )
  
  s3 = Aws::S3::Resource.new(client: s3_client)

  bucket = s3.bucket(s3_bucket_name)

  logger.info "Mock PDF remediation tool running..."
  loop do
    bucket.objects(prefix: S3Handler::INPUT_PREFIX).each do |o|
      filename = o.key.gsub(S3Handler::INPUT_PREFIX, "")
      result_key = "#{S3Handler::OUTPUT_PREFIX}#{filename}"

      unless bucket.objects.detect { |o| o.key == result_key }
        logger.info "Copying #{o.key} to #{result_key}"
        o.copy_to(bucket: s3_bucket_name, key: result_key)
      end
    end

    sleep 1
  end
rescue StandardError => e
  logger.error "Mock PDF remediation tool exiting with error: #{e.class} #{e.message}"
end
